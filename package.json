{
  "name": "dotfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "ai-sync": "./bin/symlinks/ai-sync",
    "ai-sync:check": "./bin/symlinks/ai-sync --check",
    "test": "npm run lint && oxfmt --check && vitest run && npm run ai-sync:check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "sharp": "0.35.4",
    "tsdav": "2.3.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "@types/node": "26.1.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-config-raccoon": "10.9.0",
    "oxlint-tsgolint": "7.0.2003",
    "textlint": "15.8.0",
    "textlint-filter-rule-comments": "1.3.0",
    "textlint-rule-preset-raccoon": "file:./textlint/preset",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@google/genai": false,
    "protobufjs": false,
    "fsevents@2.3.3": true
  }
}
