{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pastor.config.schema.json",
  "title": "Pastor config",
  "description": "Main config file",
  "type": "object",
  "required": ["shell", "gitHub"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "shell": {
      "type": "string",
      "minLength": 1,
      "description": "Login shell for new terminal tabs (absolute path, e.g. /bin/zsh)"
    },
    "gitHub": {
      "type": "object",
      "description": "GitHub integration polling (uses gh on PATH)",
      "required": ["pullRequestPollIntervalSeconds"],
      "additionalProperties": false,
      "properties": {
        "pullRequestPollIntervalSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum seconds between background gh pull-request checks"
        }
      }
    },
    "diff": {
      "type": "object",
      "description": "Diff Mode presentation",
      "additionalProperties": false,
      "properties": {
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "description": "Font family for Diff Mode code (e.g. SF Mono, JetBrains Mono)"
        },
        "fontSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 32,
          "description": "Point size for Diff Mode code"
        }
      }
    },
    "editor": {
      "type": "object",
      "description": "External code editor for Open in Editor / Open Project in Editor",
      "required": ["bundleId"],
      "additionalProperties": false,
      "properties": {
        "bundleId": {
          "type": "string",
          "minLength": 1,
          "description": "macOS bundle identifier (e.g. dev.zed.Zed, com.microsoft.VSCode)"
        },
        "arguments": {
          "type": "array",
          "description": "CLI flags before paths (e.g. [\"--reuse\"] for Zed, [\"-r\"] for VS Code). Uses the app’s bundled CLI.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
