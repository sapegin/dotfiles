filters:
  and:
    - file.ext == "md"
formulas:
  not_log: file.folder.startsWith("Log") == false
properties:
  formula.not_log:
    displayName: Not log
views:
  - type: cards
    name: Cards
    order:
      - file.name
      - description
    sort:
      - property: file.mtime
        direction: DESC
    limit: 100
    image: note.image
    imageAspectRatio: 0.45
    cardSize: 230
  - type: table
    name: Dashboard
    filters:
      and:
        - formula.not_log == true
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 20
  - type: table
    name: Table
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 100
